# Copy real values into Vercel: Project -> Settings -> Environment Variables.
# Never commit an actual .env.local file with real keys.

# Stripe test-mode secret key (Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_...

# Recurring Price ID for the Travel Advice Pro €5/month plan
# (Products -> create a product -> add a recurring EUR 5.00/month price)
STRIPE_PRICE_TRAVEL_ADVICE=price_...

# Webhook signing secret for the snapshot-payload destination
# (Developers -> Webhooks -> your endpoint -> Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Webhook signing secret for the thin-payload destination (separate secret,
# separate destination in Stripe's dashboard). Optional: falls back to
# STRIPE_WEBHOOK_SECRET above if unset.
STRIPE_WEBHOOK_SECRET_THIN=whsec_...

# Optional fallback if the Origin header isn't present; usually not needed
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# ---------------- Adyen (Hosted Checkout, TEST) ----------------
# Customer Area -> Developers -> API credentials -> your ws_ credential -> API key
ADYEN_API_KEY=AQE...
# Customer Area -> top-left account switcher; use the ECOM merchant account name
ADYEN_MERCHANT_ACCOUNT=YourCompanyECOM
# Customer Area -> Developers -> Webhooks -> Standard webhook -> HMAC key
ADYEN_HMAC_KEY=...
# Optional: a Hosted Checkout theme from Customer Area -> Settings -> Checkout settings
# ADYEN_THEME_ID=
